nectable="0" parent="p1_e19"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p1_e19_m1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=none;" vertex="1" connectable="0" parent="p1_e19"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p1_e20" value="entrega" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;endArrow=open;endFill=0;" edge="1" parent="1" source="p1_EvaluacionProveedor" target="p1_Lote"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e20_m0" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=none;" vertex="1" connectable="0" parent="p1_e20"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p1_e20_m1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=none;" vertex="1" connectable="0" parent="p1_e20"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p1_Lote" value="&lt;p style=&quot;margin:0;text-align:center;&quot;&gt;&lt;b&gt;Lote&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;-id: Long&lt;br&gt;-codigo: String&lt;br&gt;-fechaIngreso: LocalDate&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1086" y="820" width="200" height="105" as="geometry" /></mxCell><mxCell id="p1_lote_detalle" value="lote" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="p1_LoteRepuesto" target="p1_Lote"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_lote_detalle_m0" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" vertex="1" connectable="0" parent="p1_lote_detalle"><mxGeometry x="-0.7" y="12" relative="1" as="geometry" /></mxCell><mxCell id="p1_lote_detalle_m1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" vertex="1" connectable="0" parent="p1_lote_detalle"><mxGeometry x="0.7" y="12" relative="1" as="geometry" /></mxCell><mxCell id="mapping_final" value="&lt;b&gt;Correspondencia con final_diagrama_entidades.drawio&lt;/b&gt;&lt;br&gt;Lote → lotes; LoteRepuesto → lotes_repuestos (lote, repuesto). ReservaRepuesto referencia el detalle del lote del mismo repuesto y la linea (orden, repuesto).&lt;br&gt;OrdenServicio → servicios; OperacionServicio → servicios_detalle (orden, servicioCatalogo); ServicioRepuesto → servicios_repuestos (orden, repuesto); ServicioTecnico → servicios_tecnicos (orden, tecnico); ProveedorRepuesto → proveedores_repuestos (proveedor, repuesto).&lt;br&gt;Stock fisico = SUM(cantidadActual); disponible = fisico - reservas ACTIVAS. Reservas ACTIVAS + CONSUMIDAS de la linea no exceden cantidadRequerida; LIBERADAS no cuentan. Cantidad actual admite cero.&lt;br&gt;Factura.tasaImpuesto es dato calculado/transitorio: la BD definitiva persiste impuestos y totales, no esa columna. Los enums se mapean por nombre a sus tablas de consulta, nunca por ordinal.&lt;br&gt;Mano de obra = SUM(precioCobrado). Recordatorios por vehiculo/operacion: fechaEntrega + intervaloMeses. No hay persistencia de avisos enviados." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1880" height="190" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="2 MVC y servicios" id="p2"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p2_t" value="CarMotors - Vistas, controladores y servicios de negocio" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p2_n" value="Vista (consola, sin logica) -&gt; Controlador (intermediario) -&gt; Servicio (toda la logica de negocio). Los servicios usan las interfaces DAO de la pagina 3 y obtienen conexiones con ConexionFactory (pagina 4)." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="30" as="geometry" /></mxCell><mxCell id="p2_ClienteView" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Vista&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ClienteView&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+mostrarMenu(): void&lt;br&gt;+leerOpcion(): int&lt;br&gt;+mostrarMensaje(mensaje: String): void&lt;br&gt;+mostrarHistorial(ordenes: List&amp;lt;OrdenServicio&amp;gt;): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="451" height="119" as="geometry" /></mxCell><mxCell id="p2_OrdenServicioView" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Vista&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;OrdenServicioView&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+mostrarMenu(): void&lt;br&gt;+leerOpcion(): int&lt;br&gt;+mostrarMensaje(mensaje: String): void&lt;br&gt;+mostrarOrden(orden: OrdenServicio): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="551" y="90" width="499" height="119" as="geometry" /></mxCell><mxCell id="p2_InventarioView" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Vista&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;InventarioView&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+mostrarMenu(): void&lt;br&gt;+leerOpcion(): int&lt;br&gt;+mostrarMensaje(mensaje: String): void&lt;br&gt;+mostrarAlertas(alertas: List&amp;lt;AlertaInventario&amp;gt;): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1110" y="90" width="475" height="119" as="geometry" /></mxCell><mxCell id="p2_FacturacionView" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Vista&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;FacturacionView&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+mostrarMenu(): void&lt;br&gt;+leerOpcion(): int&lt;br&gt;+mostrarMensaje(mensaje: String): void&lt;br&gt;+mostrarFacturaTxt(texto: String): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1645" y="90" width="261" height="119" as="geometry" /></mxCell><mxCell id="p2_ProveedorV