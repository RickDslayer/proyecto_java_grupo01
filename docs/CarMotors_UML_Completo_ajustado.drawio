e="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="p3_ProveedorRepuestoDao" target="p3_GenericDao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e33" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;dashed=1;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="p3_ProveedorRepuestoDaoJdbc" target="p3_ProveedorRepuestoDao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e34" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="p3_EvaluacionProveedorDao" target="p3_GenericDao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e35" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;dashed=1;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="p3_EvaluacionProveedorDaoJdbc" target="p3_EvaluacionProveedorDao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e36" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="p3_FacturaDao" target="p3_GenericDao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_e37" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;dashed=1;endArrow=block;endFill=0;endSize=10;" edge="1" parent="1" source="p3_FacturaDaoJdbc" target="p3_FacturaDao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dao_keys" value="&lt;b&gt;Tipos de clave DAO&lt;/b&gt;&lt;br&gt;GenericDao&amp;lt;T, ID&amp;gt; debe especializarse por entidad. Claves compuestas (value objects Java, no columnas nuevas): LoteRepuestoId(loteId, repuestoId), ServicioRepuestoId(servicioId, repuestoId), OperacionServicioId(servicioId, servicioCatalogoId), ServicioTecnicoId(servicioId, tecnicoId), ProveedorRepuestoId(proveedorId, repuestoId). Las demas entidades usan Long.&lt;br&gt;Agregar LoteDao / LoteDaoJdbc para la cabecera lotes, con CRUD heredado y consultas por proveedor. LoteRepuestoDao gestiona exclusivamente lotes_repuestos.&lt;br&gt;Los DAO cierran sus PreparedStatement/ResultSet, nunca la Connection recibida. Un error debe propagarse al servicio para rollback." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2600" width="1500" height="150" as="geometry" /></mxCell><mxCell id="p3_LoteDao" value="&amp;laquo;interface&amp;raquo;&lt;br&gt;&lt;b&gt;LoteDao&lt;/b&gt;&lt;hr&gt;GenericDao&amp;lt;Lote, Long&amp;gt;&lt;br&gt;+listarPorProveedor(proveedorId: Long, con: Connection): List&amp;lt;Lote&amp;gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="2790.0" width="620" height="110" as="geometry" /></mxCell><mxCell id="p3_LoteDaoJdbc" value="&amp;laquo;JDBC&amp;raquo;&lt;br&gt;&lt;b&gt;LoteDaoJdbc&lt;/b&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="760" y="2790.0" width="620" height="110" as="geometry" /></mxCell><mxCell id="p3_LoteDao_added_edge" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=0;" edge="1" parent="1" source="p3_LoteDao" target="p3_GenericDao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p3_LoteDaoJdbc_added_edge" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="p3_LoteDaoJdbc" target="p3_LoteDao"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="4 Singleton" id="p4"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidt