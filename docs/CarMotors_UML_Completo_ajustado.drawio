="30" as="geometry" /></mxCell><mxCell id="p3_GenericDao" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;interface&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;GenericDao&amp;lt;T, ID&amp;gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+guardar(entidad: T, con: Connection): T&lt;br&gt;+buscarPorId(id: ID, con: Connection): Optional&amp;lt;T&amp;gt;&lt;br&gt;+listarTodos(con: Connection): List&amp;lt;T&amp;gt;&lt;br&gt;+actualizar(entidad: T, con: Connection): void&lt;br&gt;+eliminar(id: ID, con: Connection): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="300" height="135" as="geometry" /></mxCell><mxCell id="p3_ClienteDao" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;interface&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ClienteDao&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+buscarPorDocumento(documento: String, con: Connection): Optional&amp;lt;Cliente&amp;gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="315" width="512" height="71" as="geometry" /></mxCell><mxCell id="p3_ClienteDaoJdbc" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;JDBC&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ClienteDaoJdbc&lt;/b&gt;&lt;/p&gt;" style="verticalAlign=top;align=l