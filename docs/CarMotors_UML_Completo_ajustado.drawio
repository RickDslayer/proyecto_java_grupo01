 x="40" y="20" width="900" height="30" as="geometry" /></mxCell><mxCell id="p6_n" value="ReporteService (contexto) recibe la estrategia y la ejecuta. Cada estrategia consulta por DAO y procesa con Streams y lambdas. ReporteAlertasInventario es propuesta: consulta stock bajo minimo y lotes proximos a caducar en la base, asi las alertas vigentes se recuperan al reiniciar." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1100" height="30" as="geometry" /></mxCell><mxCell id="p6_ReporteService" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Contexto&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ReporteService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+&amp;lt;R&amp;gt; ejecutar(estrategia: EstrategiaReporte&amp;lt;R&amp;gt;, filtro: FiltroReporte): List&amp;lt;R&amp;gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="481" height="71" as="geometry" /></mxCell><mxCell id="p6_EstrategiaReporte" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;interface&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;EstrategiaReporte&amp;lt;R&amp;gt;&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+nombre(): String&lt;br&gt;+generar(filtro: FiltroReporte): List&amp;lt;R&amp;gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#e1d5e7;strokeColor=#555555;" vertex="1" parent="1"><mx