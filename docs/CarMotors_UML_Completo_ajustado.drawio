icio&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;InventarioService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+registrarRepuesto(repuesto: Repuesto): Repuesto&lt;br&gt;+registrarLote(lote: LoteRepuesto): LoteRepuesto&lt;br&gt;+reservar(ordenId: Long, repuestoId: Long): List&amp;lt;ReservaRepuesto&amp;gt;&lt;br&gt;+liberar(reservaId: Long): void&lt;br&gt;~consumirReservas(ordenId: Long, con: Connection): List&amp;lt;EventoInventario&amp;gt;&lt;br&gt;+calcularStockFisico(repuestoId: Long): int&lt;br&gt;+calcularDisponible(repuestoId: Long, fecha: LocalDate): int&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1110" y="468" width="475" height="167" as="geometry" /></mxCell><mxCell id="p2_FacturacionService" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Servicio&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;FacturacionService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+facturar(ordenId: Long): Factura&lt;br&gt;+calcularTotales(ordenId: Long): void&lt;br&gt;+reexportarTxt(facturaId: Long): String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#d5e8d4;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1645" y="468" width="261" height="103" as="geometry" /></mxCell><mxCell id="p2_ProveedorService" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Servicio&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Pr