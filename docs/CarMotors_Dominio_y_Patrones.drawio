<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram name="Dominio y patrones" id="carmotors-dominio-patrones"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="3340" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="p1_t" value="CarMotors — Modelo de dominio y aplicación de los cinco patrones" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="30" as="geometry" /></mxCell><mxCell id="p1_n" value="Cliente es información del negocio, no un usuario del sistema. Empleado o administrador opera la consola; las entidades no leen opciones, muestran menús ni llaman servicios. Solo se muestran interfaces necesarias para DAO, Strategy y Observer." style="text;html=1;fontSize=11;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1880" height="34" as="geometry" /></mxCell><mxCell id="p1_Cliente" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Cliente&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;-id: Long&lt;br&gt;-nombre: String&lt;br&gt;-documentoIdentidad: String&lt;br&gt;-telefono: String&lt;br&gt;-email: String&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#dae8fc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="188" height="121" as="geometry" /></mxCell><mxCell id="p1_Vehiculo" value="&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;Vehiculo&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;-id: Long&lt;br