;fontSize=11;fillColor=#e6f0ff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1966" y="279" width="512" height="103" as="geometry" /></mxCell><mxCell id="p2_ReporteController" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Controlador&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ReporteController&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+ejecutarReporte(): void&lt;br&gt;+verRecordatorios(): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#e6f0ff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="2538" y="279" width="481" height="87" as="geometry" /></mxCell><mxCell id="p2_CatalogoController" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Controlador&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;CatalogoController&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+registrarTecnico(): void&lt;br&gt;+registrarServicio(): void&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#e6f0ff;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="3079" y="279" width="377" height="87" as="geometry" /></mxCell><mxCell id="p2_ClienteService" value="&lt;p style=&quot;margin:0;text-align:center;font-size:10px;&quot;&gt;&lt;i&gt;&amp;laquo;Servicio&amp;raquo;&lt;/i&gt;&lt;/p&gt;&lt;p style=&quot;margin:0;margin-top:4px;text-align:center;&quot;&gt;&lt;b&gt;ClienteService&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;margin:4px 0;&quot;&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;+registrarCliente