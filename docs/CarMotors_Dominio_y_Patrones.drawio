lor=none;" vertex="1" connectable="0" parent="p1_e19"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p1_e19_m1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=none;" vertex="1" connectable="0" parent="p1_e19"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p1_e20" value="entrega" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;fontSize=10;endArrow=open;endFill=0;" edge="1" parent="1" source="p1_EvaluacionProveedor" target="p1_Lote"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_e20_m0" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=none;" vertex="1" connectable="0" parent="p1_e20"><mxGeometry x="-0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p1_e20_m1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;labelBackgroundColor=none;" vertex="1" connectable="0" parent="p1_e20"><mxGeometry x="0.85" y="-10" relative="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="p1_Lote" value="&lt;p style=&quot;margin:0;text-align:center;&quot;&gt;&lt;b&gt;Lote&lt;/b&gt;&lt;/p&gt;&lt;hr&gt;&lt;p style=&quot;margin:0 0 0 6px;&quot;&gt;-id: Long&lt;br&gt;-codigo: String&lt;br&gt;-fechaIngreso: LocalDate&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#fff2cc;strokeColor=#555555;" vertex="1" parent="1"><mxGeometry x="1086" y="820" width="200" height="105" as="geometry" /></mxCell><mxCell id="p1_lote_detalle" value="lote" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=open;endFill=0;" edge="1" parent="1" source="p1_LoteRepuesto" target="p1_Lote"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="p1_lote_detalle_m0" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" vertex="1" connectable="0" parent="p1_lote_detalle"><mxGeometry x="-0.7" y="12" relative="1" as="geometry" /></mxCell><mxCell id="p1_lote_detalle_m1" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;" vertex="1" connectable="0" parent="p1_lote_detalle"><mxGeometry x="0.7" y="12" relative="1" as="geometry" /></mxCell><mxCell id="mapping_final" value="&lt;b&gt;Correspondencia con final_diagrama_entidades.drawio&lt;/b&gt;&lt;br&gt;Lote → lotes; LoteRepuesto → lotes_repuestos (lote, repuesto). ReservaRepuesto referencia el detalle del lote del mismo repuesto y la linea (orden, repuesto).&lt;br&gt;OrdenServicio → servicios; OperacionServicio → servicios_detalle (orden, servicioCatalogo); ServicioRepuesto → servicios_repuestos (orden, repuesto); ServicioTecnico → servicios_tecnicos (orden, tecnico); ProveedorRepuesto → proveedores_repuestos (proveedor, repuesto).&lt;br&gt;Stock fisico = SUM(cantidadActual); disponible = fisico - reservas ACTIVAS. Reservas ACTIVAS + CONSUMIDAS de la linea no exceden cantidadRequerida; LIBERADAS no cuentan. Cantidad actual admite cero.&lt;br&gt;Factura.tasaImpuesto es dato calculado/transitorio: la BD definitiva persiste impuestos y totales, no esa columna. Los enums se mapean por nombre a sus tablas de consulta, nunca por ordinal.&lt;br&gt;Mano de obra = SUM(precioCobrado). Recordatorios por vehiculo/operacion: fechaEntrega + intervaloMeses. No hay persistencia de avisos enviados." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1880" height="190" as="geometry" /></mxCell><mxCell id="actor_note" value="&lt;b&gt;Empleado / administrador — actor externo&lt;/b&gt;&lt;br&gt;Usa el programa para registrar y consultar datos de clientes y gestionar el taller. No es Cliente y no se agrega una tabla de usuarios ni autenticación a este alcance.&lt;br&gt;&lt;br&gt;Las vistas y controladores quedan fuera de este lienzo. Ninguna entidad de dominio tiene métodos de interacción con la consola." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="560" height="170" as="geometry" /></mxCell><mxCell id="support_title" value="Servicios de negocio mínimos — operan sobre las entidades; no son pantallas" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1390" width="1800" height="35" as="geometry" /></mxCell><mxCell id="s_client" value="&lt;b&gt;ClienteService&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+registrar(cliente: Cliente): Cliente&lt;br&gt;+actualizarContacto(id: Long, telefono: String, email: String): void&lt;br&gt;+consultarHistorial(clienteId: Long): List&amp;lt;OrdenServicio&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1450" width="420" height="190" as="geometry" /></mxCell><mxCell id="s_order" value="&lt;b&gt;OrdenServicioService&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+crearOrden(vehiculo: Vehiculo): OrdenServicio&lt;br&gt;+asignarTecnico(ordenId: Long, tecnicoId: Long): void&lt;br&gt;+completarOrden(ordenId: Long): void&lt;br&gt;+calcularManoObra(ordenId: Long): BigDecimal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="1450" width="430" height="190" as="geometry" /></mxCell><mxCell id="s_inventory" value="&lt;b&gt;InventarioService&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+reservar(servicioId: Long, repuestoId: Long): void&lt;br&gt;+liberar(reservaId: Long): void&lt;br&gt;~consumirReservas(ordenId: Long, con: Connection): List&amp;lt;EventoInventario&amp;gt;&lt;br&gt;+consultarDisponible(repuestoId: Long): int" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="990" y="1450" width="450" height="190" as="geometry" /></mxCell><mxCell id="s_invoice" value="&lt;b&gt;FacturacionService&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+facturar(ordenId: Long): Factura&lt;br&gt;+calcularTotales(ordenId: Long): BigDecimal&lt;br&gt;+reexportarTxt(facturaId: Long): String" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1490" y="1450" width="440" height="190" as="geometry" /></mxCell><mxCell id="s_c_dom" value="gestiona datos; Cliente no llama al servicio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_client" target="p1_Cliente"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s_o_dom" value="reglas y transacciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_order" target="p1_OrdenServicio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s_i_dom" value="reservas por detalle de lote" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_inventory" target="p1_ReservaRepuesto"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s_f_dom" value="crea una sola factura por orden" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_invoice" target="p1_Factura"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s_o_i" value="comparte Connection al completar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_order" target="s_inventory"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="patterns_title" value="Patrones de diseño — clases que colaboran realmente en el sistema" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="1695" width="1850" height="35" as="geometry" /></mxCell><mxCell id="singleton" value="&lt;i&gt;Singleton&lt;/i&gt;&lt;br&gt;&lt;b&gt;ConexionFactory&lt;/b&gt;&lt;hr&gt;-instancia: ConexionFactory {static}&lt;br&gt;-url: String&lt;br&gt;-usuario: String&lt;br&gt;-clave: String&lt;hr&gt;-ConexionFactory()&lt;br&gt;+getInstancia(): ConexionFactory {static}&lt;br&gt;+crearConexion(): Connection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="1760" width="390" height="255" as="geometry" /></mxCell><mxCell id="singleton_note" value="Una instancia de configuración; una conexión NUEVA por operación. El servicio abre/cierra Connection y controla commit/rollback. No hay conexión global compartida." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="2040" width="390" height="115" as="geometry" /></mxCell><mxCell id="order_singleton" value="abre transacción" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_order" target="singleton"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="invoice_singleton" value="abre transacción" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_invoice" target="singleton"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dao" value="&lt;i&gt;interface · DAO&lt;/i&gt;&lt;br&gt;&lt;b&gt;RepuestoDao&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+guardar(r: Repuesto, con: Connection): Repuesto&lt;br&gt;+buscar(id: Long, con: Connection): Optional&amp;lt;Repuesto&amp;gt;&lt;br&gt;+actualizar(r: Repuesto, con: Connection): void&lt;br&gt;+eliminar(id: Long, con: Connection): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="1760" width="440" height="205" as="geometry" /></mxCell><mxCell id="dao_impl" value="&lt;i&gt;DAO concreto&lt;/i&gt;&lt;br&gt;&lt;b&gt;RepuestoDaoJdbc&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;Implementa operaciones con PreparedStatement.&lt;br&gt;No conserva ni cierra la Connection recibida." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="2030" width="440" height="125" as="geometry" /></mxCell><mxCell id="dao_realize" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="dao_impl" target="dao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="inventory_dao" value="depende del contrato DAO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_inventory" target="dao"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="dao_entity" value="mapea datos; sin reglas de negocio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="dao_impl" target="p1_Repuesto"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="creator" value="&lt;i&gt;abstract · Factory Method&lt;/i&gt;&lt;br&gt;&lt;b&gt;DaoCreator&amp;lt;D&amp;gt;&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+obtenerDao(): D&lt;br&gt;#crearDao(): D {abstract}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="1760" width="400" height="145" as="geometry" /></mxCell><mxCell id="creator_concrete" value="&lt;i&gt;creador concreto&lt;/i&gt;&lt;br&gt;&lt;b&gt;RepuestoDaoCreator&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;#crearDao(): RepuestoDao" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="1970" width="400" height="125" as="geometry" /></mxCell><mxCell id="creator_inherit" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;" edge="1" parent="1" source="creator_concrete" target="creator"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="creator_product" value="crea producto concreto" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="creator_concrete" target="dao_impl"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="factory_note" value="obtenerDao() llama a crearDao(), sobrescrito por el creador concreto. Devuelve un DAO sin conexión asociada. El servicio recibe el creador por constructor. No hay fábrica estática con switch.&lt;br&gt;Se muestra Repuesto como ejemplo; cada entidad persistente tiene su DAO, respetando sus claves simples o compuestas." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1490" y="1760" width="440" height="220" as="geometry" /></mxCell><mxCell id="service_creator" value="obtiene RepuestoDao" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_inventory" target="creator"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="strategy_title" value="Strategy — cambia el algoritmo del reporte sin cambiar las entidades" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2210" width="1850" height="30" as="geometry" /></mxCell><mxCell id="report_service" value="&lt;i&gt;contexto Strategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;ReporteService&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+ejecutar(estrategia: EstrategiaReporte, filtro: FiltroReporte): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="2270" width="390" height="140" as="geometry" /></mxCell><mxCell id="strategy" value="&lt;i&gt;interface · Strategy&lt;/i&gt;&lt;br&gt;&lt;b&gt;EstrategiaReporte&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+generar(filtro: FiltroReporte): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="2270" width="440" height="125" as="geometry" /></mxCell><mxCell id="filter" value="&lt;i&gt;DTO · sin tabla&lt;/i&gt;&lt;br&gt;&lt;b&gt;FiltroReporte&lt;/b&gt;&lt;hr&gt;-desde: LocalDate&lt;br&gt;-hasta: LocalDate" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="2270" width="400" height="110" as="geometry" /></mxCell><mxCell id="strategy_note" value="El empleado/admin elige el reporte mediante la consola. El controlador entrega la estrategia a ReporteService. Cada estrategia consulta DAO y usa Streams/Lambdas; devuelve filas de texto, sin leer ni imprimir consola. List&lt;String&gt; simplifica la salida; se pueden tipar DTO más adelante si aportan valor." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1490" y="2255" width="440" height="180" as="geometry" /></mxCell><mxCell id="str_services" value="&lt;b&gt;ReporteServiciosMasSolicitados&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+generar(filtro: FiltroReporte): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="2470" width="570" height="120" as="geometry" /></mxCell><mxCell id="str_technicians" value="&lt;b&gt;ReporteProductividadTecnico&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+generar(filtro: FiltroReporte): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="690" y="2470" width="570" height="120" as="geometry" /></mxCell><mxCell id="str_parts" value="&lt;b&gt;ReporteConsumoRepuestos&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+generar(filtro: FiltroReporte): List&amp;lt;String&amp;gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1360" y="2470" width="570" height="120" as="geometry" /></mxCell><mxCell id="context_strategy" value="ejecuta la estrategia recibida" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="report_service" target="strategy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="strategy_impl_0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="str_services" target="strategy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="strategy_impl_1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="str_technicians" target="strategy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="strategy_impl_2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="str_parts" target="strategy"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="str_ops" value="agrupa operaciones por catálogo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="str_services" target="p1_OperacionServicio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="str_tech" value="participación / horas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="str_technicians" target="p1_ServicioTecnico"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="str_res" value="solo CONSUMIDAS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="str_parts" target="p1_ReservaRepuesto"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="observer_title" value="Observer — genera alertas de inventario tras cambios confirmados" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="2650" width="1850" height="30" as="geometry" /></mxCell><mxCell id="publisher" value="&lt;i&gt;sujeto Observer&lt;/i&gt;&lt;br&gt;&lt;b&gt;PublicadorInventario&lt;/b&gt;&lt;hr&gt;-observadores: List&amp;lt;ObservadorInventario&amp;gt;&lt;hr&gt;+suscribir(o: ObservadorInventario): void&lt;br&gt;+cancelar(o: ObservadorInventario): void&lt;br&gt;+publicar(e: EventoInventario): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="2710" width="410" height="185" as="geometry" /></mxCell><mxCell id="observer" value="&lt;i&gt;interface · Observer&lt;/i&gt;&lt;br&gt;&lt;b&gt;ObservadorInventario&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+actualizar(e: EventoInventario): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="2710" width="440" height="110" as="geometry" /></mxCell><mxCell id="event" value="&lt;i&gt;DTO · sin tabla&lt;/i&gt;&lt;br&gt;&lt;b&gt;EventoInventario&lt;/b&gt;&lt;hr&gt;-repuestoId: Long&lt;br&gt;-loteId: Long&lt;br&gt;-tipoMovimiento: String&lt;br&gt;-ocurridoEn: LocalDateTime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="2710" width="400" height="145" as="geometry" /></mxCell><mxCell id="observer_note" value="El evento describe un cambio, no una alerta ya decidida. Los observadores evalúan stock/caducidad y generan AlertaInventario. Se publican eventos solo después de commit; con rollback se descartan. Un fallo del observador no revierte una operación ya confirmada.&lt;br&gt;La caducidad también se consulta por reporte al iniciar/solicitarlo: el paso del tiempo no produce por sí solo un evento de inventario." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="1490" y="2695" width="440" height="210" as="geometry" /></mxCell><mxCell id="obs_stock" value="&lt;b&gt;ObservadorStockMinimo&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+actualizar(e: EventoInventario): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="510" y="2910" width="440" height="110" as="geometry" /></mxCell><mxCell id="obs_exp" value="&lt;b&gt;ObservadorCaducidad&lt;/b&gt;&lt;hr&gt;&amp;nbsp;&lt;hr&gt;+actualizar(e: EventoInventario): void" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;fontSize=12;spacing=6;" vertex="1" parent="1"><mxGeometry x="1030" y="2910" width="400" height="110" as="geometry" /></mxCell><mxCell id="publisher_contract" value="notifica observadores suscritos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="publisher" target="observer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="obs_stock_impl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="obs_stock" target="observer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="obs_exp_impl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=block;endFill=0;dashed=1;" edge="1" parent="1" source="obs_exp" target="observer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="order_publish" value="publica después del commit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_order" target="publisher"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="inv_publish" value="publica al confirmar reservas/ingresos/liberaciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=11;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1" source="s_inventory" target="publisher"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="final_note" value="&lt;b&gt;Alcance del lienzo&lt;/b&gt;&lt;br&gt;Las entidades existentes mantienen su ubicación. Los servicios y patrones se añaden debajo para explicar cómo colaboran con el dominio, sin reproducir vistas/controladores ni todos los DAO.&lt;br&gt;Cliente, Proveedor y Tecnico son entidades informativas, sin lectura de consola. Empleado/admin es el actor, no una nueva tabla de autenticación. Interfaces solo para contratos DAO y comportamiento intercambiable (Strategy/Observer); no se agregan interfaces a todas las clases.&lt;br&gt;La base de datos definitiva sigue siendo final_diagrama_entidades.drawio; ningún patrón agrega tablas por sí mismo." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;fontSize=12;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="3110" width="1880" height="150" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>